# Required for stable production sessions. Generate with a password manager.
JWT_SECRET=replace-with-at-least-32-random-bytes

# Server and persistence
PORT=3001
CARAML_DB_PATH=./data/caraml.db
CARAML_ALLOWED_ORIGINS=

# Native execution is disabled by default when NODE_ENV=production.
# Only enable it when the server itself runs inside a hardened sandbox.
CARAML_ENABLE_NATIVE_EXECUTION=0
CARAML_MAX_CODE_BYTES=100000

# Optional explicit tool paths for trusted/local environments
CARAML_OCAML_PATH=
CARAML_OCAMLMERLIN_PATH=
CARAML_OCAMLFORMAT_PATH=
