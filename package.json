{
  "name": "caraml",
  "version": "1.0.0",
  "description": "Web-based OCaml IDE with code execution, memory visualization, project sharing, and Learn OCaml integration",
  "homepage": "https://lucideai.github.io/Caraml/",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucideAI/Caraml.git"
  },
  "keywords": [
    "ocaml",
    "ide",
    "interpreter",
    "monaco-editor",
    "functional-programming"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:no-ocaml": "node scripts/dev.mjs --skip-ocaml",
    "dev:client": "vite --port 5173",
    "dev:server": "node server.js",
    "ensure:ocaml": "node scripts/ensure-ocaml.mjs",
    "setup:ocaml": "node scripts/setup-ocaml.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dompurify": "^3.4.9",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.294.0",
    "monaco-editor": "^0.44.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
